{
  "name": "vedic-panchanga",
  "version": "0.1.0",
  "description": "Vedic Panchanga and Kundali calculator for Node.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist/"],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "format": "prettier --write src/ test/",
    "format:check": "prettier --check src/ test/"
  },
  "keywords": [
    "vedic",
    "panchang",
    "panchangam",
    "jyotish",
    "astrology",
    "kundali",
    "horoscope",
    "dasha",
    "nakshatra",
    "tithi",
    "swisseph"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "swisseph": "^0.5.17"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
